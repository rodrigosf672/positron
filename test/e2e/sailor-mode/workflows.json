		"console-stress-test": {
			"name": "Console Stress Test",
			"description": "Test console with heavy load and edge cases",
			"requiredFixtures": ["app", "python"],
			"estimatedDuration": "10 minutes",
			"steps": [
				{
					"name": "Execute long-running computation",
					"pageObject": "console",
					"method": "executeCode",
					"params": ["Python", "import time\nfor i in range(5):\n		 print(f'Step {i}')\n		 time.sleep(1)"],
					"timeout": 10000
				},
				{
					"name": "Test console interrupt",
					"pageObject": "console",
					"method": "executeCode",
					"params": ["Python", "while True:\n		 pass"],
					"note": "Will be interrupted"
				},
				{
					"name": "Send interrupt",
					"pageObject": "console",
					"method": "sendInterrupt",
					"params": []
				},
				{
					"name": "Verify console responsive",
					"pageObject": "console",
					"method": "waitForReady",
					"params": [">>>"]
				},
				{
					"name": "Test large output",
					"pageObject": "console",
					"method": "executeCode",
					"params": ["Python", "for i in range(1000):\n		 print(i)"]
				},
				{
					"name": "Test special characters",
					"pageObject": "console",
					"method": "executeCode",
					"params": ["Python", "print('Hello 世界 🌍')"]
				},
				{
					"name": "Test error handling",
					"pageObject": "console",
					"method": "executeCode",
					"params": ["Python", "1 / 0"]
				},
				{
					"name": "Verify error output",
					"pageObject": "console",
					"method": "waitForConsoleContents",
					"params": ["ZeroDivisionError"]
				}
			]
		},

		"session-management": {
			"name": "Session Management",
			"description": "Test session lifecycle and switching",
			"requiredFixtures": ["app"],
			"estimatedDuration": "7 minutes",
			"steps": [
				{
					"name": "Start Python session",
					"pageObject": "sessions",
					"method": "start",
					"params": ["python"]
				},
				{
					"name": "Verify Python session active",
					"pageObject": "sessions",
					"method": "expectStatusToBe",
					"params": ["__sessionId__", "idle"]
				},
				{
					"name": "Start R session",
					"pageObject": "sessions",
					"method": "start",
					"params": ["r"]
				},
				{
					"name": "Verify multiple sessions",
					"pageObject": "sessions",
					"method": "expectSessionCountToBe",
					"params": [2]
				},
				{
					"name": "Switch to Python session",
					"pageObject": "sessions",
					"method": "switchToSession",
					"params": ["python"]
				},
				{
					"name": "Execute Python code",
					"pageObject": "console",
					"method": "executeCode",
					"params": ["Python", "x = 'python'"]
				},
				{
					"name": "Switch to R session",
					"pageObject": "sessions",
					"method": "switchToSession",
					"params": ["r"]
				},
				{
					"name": "Execute R code",
					"pageObject": "console",
					"method": "executeCode",
					"params": ["R", "x <- 'r'"]
				},
				{
					"name": "Restart Python session",
					"pageObject": "sessions",
					"method": "restart",
					"params": ["__pythonSessionId__"]
				}
			]
		},

