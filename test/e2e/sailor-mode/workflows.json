{
	"workflows": {
		"python-development": {
			"name": "Python Development Workflow",
			"description": "Complete Python development cycle from session start to debugging",
			"requiredFixtures": ["app", "python"],
			"estimatedDuration": "5 minutes",
			"steps": [
				{
					"name": "Start Python session",
					"pageObject": "sessions",
					"method": "start",
					"params": ["python"],
					"validation": {
						"type": "state-matches",
						"pageObject": "console",
						"method": "waitForReady",
						"params": [">>>"]
					}
				},
				{
					"name": "Create scalar variable",
					"pageObject": "console",
					"method": "executeCode",
					"params": ["Python", "x = 42"],
					"validation": {
						"type": "element-visible",
						"pageObject": "variables",
						"method": "waitForVariableRow",
						"params": ["x"]
					}
				},
				{
					"name": "Verify scalar value",
					"pageObject": "variables",
					"method": "expectVariableToBe",
					"params": ["x", "42"]
				},
				{
					"name": "Create list variable",
					"pageObject": "console",
					"method": "executeCode",
					"params": ["Python", "my_list = [1, 2, 3, 4, 5]"],
					"validation": {
						"type": "element-visible",
						"pageObject": "variables",
						"method": "waitForVariableRow",
						"params": ["my_list"]
					}
				},
				{
					"name": "Create DataFrame",
					"pageObject": "console",
					"method": "executeCode",
					"params": ["Python", "import pandas as pd\ndf = pd.DataFrame({'A': [1, 2, 3], 'B': [4, 5, 6]})"],
					"validation": {
						"type": "element-visible",
						"pageObject": "variables",
						"method": "waitForVariableRow",
						"params": ["df"]
					}
				},
				{
					"name": "Open DataFrame in Data Explorer",
					"pageObject": "variables",
					"method": "doubleClickVariableRow",
					"params": ["df"],
					"validation": {
						"type": "state-matches",
						"pageObject": "dataExplorer",
						"method": "waitForIdle",
						"params": []
					}
				},
				{
					"name": "Verify Data Explorer content",
					"pageObject": "dataExplorer",
					"method": "grid.verifyTableDataLength",
					"params": [3]
				}
			]
		},

		"data-explorer-deep-dive": {
			"name": "Data Explorer Deep Dive",
			"description": "Comprehensive testing of Data Explorer features",
			"requiredFixtures": ["app", "python"],
			"estimatedDuration": "15 minutes",
			"steps": [
				{
					"name": "Setup: Create large DataFrame",
					"pageObject": "console",
					"method": "executeCode",
					"params": ["Python", "import pandas as pd\nimport numpy as np\ndf = pd.DataFrame({\n	'Name': [f'Person_{i}' for i in range(100)],\n	'Age': np.random.randint(20, 60, 100),\n	'Score': np.random.rand(100) * 100\n})"]
				},
				{
					"name": "Open in Data Explorer",
					"pageObject": "variables",
					"method": "doubleClickVariableRow",
					"params": ["df"],
					"validation": {
						"type": "state-matches",
						"pageObject": "dataExplorer",
						"method": "waitForIdle",
						"params": []
					}
				},
				{
					"name": "Test column sorting ascending",
					"pageObject": "dataExplorer",
					"method": "selectColumnHeader",
					"params": ["Age"],
					"validation": {
						"type": "state-matches",
						"pageObject": "dataExplorer",
						"method": "waitForIdle",
						"params": []
					}
				},
				{
					"name": "Test column sorting descending",
					"pageObject": "dataExplorer",
					"method": "selectColumnHeader",
					"params": ["Age"],
					"validation": {
						"type": "state-matches",
						"pageObject": "dataExplorer",
						"method": "waitForIdle",
						"params": []
					}
				},
				{
					"name": "Test column filtering",
					"pageObject": "dataExplorer",
					"method": "filters.setFilter",
					"params": ["Age", ">", "30"]
				},
				{
					"name": "Verify filter applied",
					"pageObject": "dataExplorer",
					"method": "grid.verifyTableDataLength",
					"params": ["<100"],
					"note": "Should be less than 100 rows after filtering"
				},
				{
					"name": "Clear filters",
					"pageObject": "dataExplorer",
					"method": "filters.clearAllFilters",
					"params": []
				},
				{
					"name": "Test summary panel",
					"pageObject": "dataExplorer",
					"method": "editorActionBar.clickButton",
					"params": ["Summary Panel"]
				},
				{
					"name": "Test convert to code",
					"pageObject": "dataExplorer",
					"method": "editorActionBar.clickButton",
					"params": ["Convert to Code"]
				}
			]
		},

